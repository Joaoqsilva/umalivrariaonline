function adicionarLivroCard(livro) {
    const container = document.getElementById('container-livros');
    if (!container) {
        console.error("Container #container-livros não encontrado. Verifique o HTML.");
        return;
    }
    
    const cardDiv = document.createElement('div');
    
    // Configura o ID do card baseado no título para o Foco (Scroll)
    const idParaFoco = livro.titulo.toLowerCase().replace(/\s+/g, '-');
    cardDiv.id = idParaFoco; // <-- Adiciona o ID ao card
    
    // ... (restante do código da categoria e imagem permanece o mesmo) ...
    const firstCategory = livro.categorias && livro.categorias.length > 0 
                             ? livro.categorias[0].toLowerCase().replace(/\s/g, '-') 
                             : 'sem-categoria';
                             
    const categoriaClasse = `categoria-${firstCategory}`;
    cardDiv.classList.add('livro', categoriaClasse);
    
    const imgElement = document.createElement('img');
    imgElement.src = livro.capaUrl;
    imgElement.alt = `Capa do livro: ${livro.titulo}`;
    
    const categoriasInfo = document.createElement('p');
    categoriasInfo.style.fontSize = '0.85em';
    categoriasInfo.style.color = '#6c757d'; 
    categoriasInfo.style.marginBottom = '10px';
    categoriasInfo.style.padding = '0 10px';
    categoriasInfo.style.textAlign = 'center';
    categoriasInfo.style.fontStyle = 'italic';
    categoriasInfo.style.whiteSpace = 'nowrap';
    categoriasInfo.style.overflow = 'hidden';
    categoriasInfo.style.textOverflow = 'ellipsis';
    
    const tituloBaixarDiv = document.createElement('div');
    tituloBaixarDiv.classList.add('tituloebaixar');
    
    const tituloSpan = document.createElement('span');
    tituloSpan.classList.add('titulo');
    tituloSpan.textContent = livro.titulo;
    
    const ulElement = document.createElement('ul');
    ulElement.classList.add('lista-botoes-livro');
    
    // 1. Botão "Baixar PDF" (Existente)
    const liBaixar = document.createElement('li');
    const linkBaixar = document.createElement('a');
    linkBaixar.href = livro.pdfUrl;
    linkBaixar.textContent = 'Baixar PDF';
    
    liBaixar.appendChild(linkBaixar);
    ulElement.appendChild(liBaixar);
    
    // 2. NOVO: Botão "Compartilhar" com função de cópia
    const liCompartilhar = document.createElement('li');
    const botaoCompartilhar = document.createElement('button'); // Mudado para <button> para a ação
    botaoCompartilhar.type = 'button';
    
    // Chama a função de cópia ao clicar, passando o título do livro e o próprio botão para feedback
    // ATENÇÃO: Mudança importante aqui: o evento agora é um clique que chama a função JS.
    botaoCompartilhar.onclick = () => copiarLinkDoLivro(livro.titulo, botaoCompartilhar);
    
    // Conteúdo e estilo do botão
    botaoCompartilhar.innerHTML = '<span><i class="fa-solid fa-share-from-square"></i></span>'; 
    // Compartilhar
    botaoCompartilhar.style.cursor = 'pointer'; // Para indicar que é clicável
    
    liCompartilhar.appendChild(botaoCompartilhar);
    ulElement.appendChild(liCompartilhar);
    
    // Estilização do botão para parecer um link/botão
   //  Adicione esta estilização ao seu CSS para ter melhor controle visual:
    

    tituloBaixarDiv.appendChild(tituloSpan);
    tituloBaixarDiv.appendChild(ulElement);
    
    cardDiv.appendChild(imgElement);
    cardDiv.appendChild(tituloBaixarDiv);
    cardDiv.appendChild(categoriasInfo); 
    
    container.appendChild(cardDiv);
}














